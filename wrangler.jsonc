/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "morph",
  "compatibility_date": "2026-03-24",
  "compatibility_flags": ["nodejs_compat"],
  // User-owned entry instead of "@tanstack/react-start/server-entry".
  // See src/server.ts for why (TanStack/router#7285 breaks SSR HMR).
  "main": "src/server.ts",
  "observability": {
    "enabled": true,
  },
  "placement": { "mode": "smart" },
  "d1_databases": [
    {
      "binding": "DATABASE",
      "database_name": "morph-d1-global",
      "database_id": "43d5c881-bd19-4020-92cc-3945d8b5cb39",
      "migrations_dir": "drizzle",
    },
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "d59ec8725b024e28a5783ab38c9384f7",
    },
  ],
  "r2_buckets": [
    {
      "binding": "R2_BUCKET",
      "bucket_name": "morph-r2-global",
      "preview_bucket_name": "morph-r2-global",
    },
  ],
  "queues": {
    "producers": [
      {
        "binding": "THEME_BUILD_QUEUE",
        "queue": "morph-theme-builds",
      },
    ],
    "consumers": [
      {
        "queue": "morph-theme-builds",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 3,
      },
    ],
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "Sandbox",
        "class_name": "Sandbox",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Sandbox"],
    },
  ],
  "containers": [
    {
      "class_name": "Sandbox",
      "image": "./Dockerfile.sandbox",
    },
  ],
  // IMPORTANT: Do NOT put BETTER_AUTH_SECRET in vars!

  // Set it as a secret using: pnpm wrangler secret put BETTER_AUTH_SECRET
  /**
   * Smart Placement
   * Docs: https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
   */
  //
  /**
   * Bindings
   * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
   * databases, object storage, AI inference, real-time communication and more.
   * https://developers.cloudflare.com/workers/runtime-apis/bindings/
   */
  /**
   * Environment Variables
   * https://developers.cloudflare.com/workers/wrangler/configuration/#environment-variables
   */
  "vars": {
    // Keep the workers.dev URL as the safe default platform origin.
    // For production split-domain deployments, replace it with the CMS
    // Custom Domain (for example https://shop.example.com) and add the same
    // hostname as MORPH_CMS_HOSTNAME. See DEPLOY.md for the route shape.
    "PUBLIC_URL": "https://morph.yuho0298.workers.dev",
    // "MORPH_CMS_HOSTNAME": "shop.example.com",
    // "MORPH_PLATFORM_HOSTNAMES": "staging.example.com,admin.example.com",
    "SANDBOX_TRANSPORT": "rpc",
  },

  // Secrets are configured outside source control:
  // pnpm wrangler secret put BETTER_AUTH_SECRET
  // pnpm wrangler secret put RESEND_API_KEY
  /**
   * Note: Use secrets to store sensitive data.
   * https://developers.cloudflare.com/workers/configuration/secrets/
   */
  /**
   * Static Assets
   * https://developers.cloudflare.com/workers/static-assets/binding/
   */
  // "assets": { "directory": "./public/", "binding": "ASSETS" }
  /**
   * Service Bindings (communicate between multiple Workers)
   * https://developers.cloudflare.com/workers/wrangler/configuration/#service-bindings
   */
  // "services": [{ "binding": "MY_SERVICE", "service": "my-service" }]
}
