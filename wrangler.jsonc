/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "morph",
  "compatibility_date": "2026-03-24",
  "compatibility_flags": ["nodejs_compat"],
  // User-owned entry instead of "@tanstack/react-start/server-entry".
  // See src/server.ts for why (TanStack/router#7285 breaks SSR HMR).
  "main": "src/server.ts",
  // Morph's static files (its public/ and build assets) are served by the
  // Worker, through this binding, and only on a platform hostname. Without
  // run_worker_first, Cloudflare answers any path matching one of them before
  // the Worker sees the hostname, so a merchant's storefront would get Morph's
  // /favicon.ico, /robots.txt or /manifest.json. See src/server/platform-assets.ts.
  // The directory is the build's client output, which the Vite plugin sets.
  // The exceptions are Vite's dev-server module paths, which no deployed asset
  // directory has: sent through the Worker, each of a page's ~90 modules waits
  // on it in local dev, and sign-in took ~37s to hydrate instead of ~2s.
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": [
      "/*",
      "!/@vite/*",
      "!/@id/*",
      "!/@fs/*",
      "!/@react-refresh",
      "!/src/*",
      "!/node_modules/*",
    ],
  },
  "observability": {
    "enabled": true,
  },
  "placement": { "mode": "smart" },
  "d1_databases": [
    {
      "binding": "DATABASE",
      "database_name": "morph-d1-global",
      "database_id": "43d5c881-bd19-4020-92cc-3945d8b5cb39",
      "migrations_dir": "drizzle",
    },
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "d59ec8725b024e28a5783ab38c9384f7",
    },
  ],
  "r2_buckets": [
    {
      "binding": "R2_BUCKET",
      "bucket_name": "morph-r2-global",
      "preview_bucket_name": "morph-r2-global",
    },
  ],
  "queues": {
    "producers": [
      {
        "binding": "THEME_BUILD_QUEUE",
        "queue": "morph-theme-builds",
      },
      {
        "binding": "INVENTORY_EXPORT_QUEUE",
        "queue": "morph-inventory-exports",
      },
    ],
    "consumers": [
      {
        "queue": "morph-theme-builds",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 3,
      },
      {
        "queue": "morph-inventory-exports",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 3,
      },
    ],
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "Sandbox",
        "class_name": "Sandbox",
      },
      // Live Preview containers: the same image, with the preview's outbound
      // policy (src/server/preview-sandbox.ts). Builds and deployments stay
      // on `Sandbox`.
      {
        "name": "PreviewSandbox",
        "class_name": "PreviewSandbox",
      },
      // Build Preview containers: one build's artifact per capability, with
      // their own outbound policy (src/server/build-preview-sandbox.ts).
      {
        "name": "BuildPreviewSandbox",
        "class_name": "BuildPreviewSandbox",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Sandbox"],
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["PreviewSandbox"],
    },
    {
      "tag": "v3",
      "new_sqlite_classes": ["BuildPreviewSandbox"],
    },
  ],
  // Instance sizes from the local measurements in
  // docs/evidence/container-sizing-2026-10.md. Without `instance_type` every
  // container is `lite` (256 MiB), where all three workloads were OOM-killed.
  "containers": [
    // Builds and deployments. Sized by CPU: each build command has a fixed
    // 120 s budget, and ¼ vCPU timed out. 1 vCPU passed every replay; 3 GiB
    // (the least Cloudflare allows per vCPU) is 1.6× the largest unconstrained
    // peak (1.9 GiB). The disk matches `basic`'s, which holds the image.
    {
      "class_name": "Sandbox",
      "image": "./Dockerfile.sandbox",
      "instance_type": {
        "vcpu": 1,
        "memory_mib": 3072,
        "disk_mb": 4000,
      },
    },
    // Live Preview: peaks under 520 MiB while starting, settles near 380 MiB.
    {
      "class_name": "PreviewSandbox",
      "image": "./Dockerfile.sandbox",
      "instance_type": "basic",
    },
    // Build Preview: under 460 MiB.
    {
      "class_name": "BuildPreviewSandbox",
      "image": "./Dockerfile.sandbox",
      "instance_type": "basic",
    },
  ],
  // IMPORTANT: Do NOT put BETTER_AUTH_SECRET in vars!

  // Set it as a secret using: pnpm wrangler secret put BETTER_AUTH_SECRET
  /**
   * Smart Placement
   * Docs: https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
   */
  //
  /**
   * Bindings
   * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
   * databases, object storage, AI inference, real-time communication and more.
   * https://developers.cloudflare.com/workers/runtime-apis/bindings/
   */
  /**
   * Environment Variables
   * https://developers.cloudflare.com/workers/wrangler/configuration/#environment-variables
   */
  "vars": {
    // Keep the workers.dev URL as the safe default platform origin.
    // For production split-domain deployments, replace it with the CMS
    // Custom Domain (for example https://shop.example.com) and add the same
    // hostname as MORPH_CMS_HOSTNAME. See DEPLOY.md for the route shape.
    "PUBLIC_URL": "https://morph.yuho0298.workers.dev",
    // "MORPH_CMS_HOSTNAME": "shop.example.com",
    // "MORPH_PLATFORM_HOSTNAMES": "staging.example.com,admin.example.com",
    "SANDBOX_TRANSPORT": "rpc",
    // Hostname the Live Preview dev server is reached on. It runs Theme
    // JavaScript, so it must be a host of its own: anything that shares a
    // cookie jar with the CMS is refused, and with nothing set here the
    // Live Preview stays on the compatibility renderer instead.
    "THEME_PREVIEW_HOSTNAME": "preview.localhost",
    // This is the only switch: set it and the editor frames a real React
    // preview, leave it unset and it stays on the compatibility renderer.
  },

  // Secrets are configured outside source control:
  // pnpm wrangler secret put BETTER_AUTH_SECRET
  // pnpm wrangler secret put RESEND_API_KEY
  /**
   * Note: Use secrets to store sensitive data.
   * https://developers.cloudflare.com/workers/configuration/secrets/
   */
  /**
   * Static Assets
   * https://developers.cloudflare.com/workers/static-assets/binding/
   */
  // "assets": { "directory": "./public/", "binding": "ASSETS" }
  /**
   * Service Bindings (communicate between multiple Workers)
   * https://developers.cloudflare.com/workers/wrangler/configuration/#service-bindings
   */
  // "services": [{ "binding": "MY_SERVICE", "service": "my-service" }]

  /**
   * Editor end-to-end runs, on a machine that may have no container.
   *
   * The Live Preview has two transports behind one contract, and the factory
   * prefers the sandbox whenever `Sandbox` is bound — deliberately, so a
   * deployment can never fall back to running Theme code beside the CMS. The
   * consequence is that the local transport is unreachable on any machine where
   * the container exists, which is every developer machine. This environment is
   * how it gets exercised: the same Worker, with no container bound, so the
   * factory resolves the loopback sidecar instead.
   *
   * **The omission is the point.** `containers` and `durable_objects` are absent
   * on purpose. Wrangler warns that they "exist at the top level, but not on
   * this environment" and suggests adding them; that warning is expected here,
   * and acting on it silently turns these runs back into sandbox runs while
   * every test still passes. The editor specs cannot tell the difference — only
   * the transport-identity assertion in the E2E suite can, which is why it runs
   * before them.
   *
   * Everything else is repeated rather than inherited because Wrangler does not
   * inherit bindings into environments. Keep it in step with the top level; a
   * binding that exists there and not here fails at runtime, not at config time.
   */
  "env": {
    "local_preview_e2e": {
      "d1_databases": [
        {
          "binding": "DATABASE",
          "database_name": "morph-d1-global",
          "database_id": "43d5c881-bd19-4020-92cc-3945d8b5cb39",
          "migrations_dir": "drizzle",
        },
      ],
      "kv_namespaces": [
        {
          "binding": "KV",
          "id": "d59ec8725b024e28a5783ab38c9384f7",
        },
      ],
      "r2_buckets": [
        {
          "binding": "R2_BUCKET",
          "bucket_name": "morph-r2-global",
          "preview_bucket_name": "morph-r2-global",
        },
      ],
      "queues": {
        "producers": [
          {
            "binding": "THEME_BUILD_QUEUE",
            "queue": "morph-theme-builds",
          },
          {
            "binding": "INVENTORY_EXPORT_QUEUE",
            "queue": "morph-inventory-exports",
          },
        ],
        "consumers": [
          {
            "queue": "morph-inventory-exports",
            "max_batch_size": 1,
            "max_batch_timeout": 5,
            "max_retries": 3,
          },
        ],
      },
      "vars": {
        // 3000 because that is the port `pnpm dev` uses, not because anything
        // requires it. Outside production both `getPublicURL` and the auth
        // base URL follow the origin the request arrived on (see
        // `src/server/public-origin.ts`), so a run on another port serves its
        // pages and checks its sign-ins against the same origin. This value is
        // the fallback for a server function with no request in hand, and the
        // configured origin in production, where the request is never trusted.
        "PUBLIC_URL": "http://localhost:3000",
        // The preview runs Theme JavaScript, so it needs a host of its own.
        // The sidecar serves loopback; this is the name the editor frames it by.
        "THEME_PREVIEW_HOSTNAME": "127.0.0.1",
      },
    },
  },
}
