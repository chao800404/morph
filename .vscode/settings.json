{
  // routeTree.gen.ts is generated by the router plugin.
  //
  // It is hidden from search and marked read-only so nobody edits it by hand,
  // but it is deliberately NOT in files.watcherExclude: route context types
  // flow from this file, so excluding it from the watcher leaves the TypeScript
  // server holding a stale copy after any route is added or removed, which
  // shows up as spurious "implicitly has an 'any' type" errors that `tsc` does
  // not reproduce.
  "search.exclude": {
    "**/routeTree.gen.ts": true
  },
  "files.readonlyInclude": {
    "**/routeTree.gen.ts": true
  },
  // Use the workspace TypeScript so the editor matches `pnpm exec tsc`.
  "typescript.tsdk": "node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnPaste": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit",
    "source.organizeImports": "explicit"
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[css]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "editor.tabCompletion": "on",
  "editor.tabMovesFocus": false,
  "editor.quickSuggestions": {
    "other": true,
    "comments": false,
    "strings": true
  },
  "editor.suggestOnTriggerCharacters": true,
  "editor.inlineSuggest.enabled": true,
  "emmet.triggerExpansionOnTab": true,
  "typescript.suggest.completeFunctionCalls": true
}
