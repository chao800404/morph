# Cloudflare D1 Configuration (for drizzle-kit migrations)
# Get these values from your Cloudflare dashboard

# Account ID: https://dash.cloudflare.com/ (right sidebar)
CLOUDFLARE_ACCOUNT_ID=your_account_id_here

# Database ID: Run `pnpm wrangler d1 create your-database-name` and copy the ID
CLOUDFLARE_DATABASE_ID=your_database_id_here

# API Token: https://dash.cloudflare.com/profile/api-tokens
# Required permissions: D1:Edit, Workers:Edit
CLOUDFLARE_D1_TOKEN=your_d1_api_token_here

# Storefront custom domains (server-only; do not expose these to the client)
# Token permissions: Workers Scripts:Edit and Workers Routes:Edit
CLOUDFLARE_API_TOKEN=your_workers_api_token_here
CLOUDFLARE_ZONE_ID=your_zone_id_here
CLOUDFLARE_WORKER_SERVICE=morph

# Better Auth Configuration
# Generate a random secret: openssl rand -base64 32
BETTER_AUTH_SECRET=your_secret_here

# Transactional email (password reset / verification)
RESEND_API_KEY=your_resend_api_key_here

# Canonical CMS URL (for server-side auth and platform-host routing)
# Local development: http://localhost:3000
# Production: use the CMS custom domain, for example https://shop.example.com
PUBLIC_URL=http://localhost:3000

# Optional additional CMS/platform hostnames. Values may be comma-separated
# hostnames or full origins. These hosts always stay on the CMS router; every
# other valid custom hostname is treated as storefront traffic.
# MORPH_PLATFORM_HOSTNAMES=staging.example.com,https://admin.example.com
# MORPH_CMS_HOSTNAME=shop.example.com

# Local development only. Activates storefront domains without calling
# Cloudflare, so the storefront request path can be exercised offline.
# Refused in production: a locally activated hostname is not routed by
# Cloudflare, so the domain would report as connected yet never serve.
# Ignored whenever the Cloudflare credentials above are configured.
# MORPH_ALLOW_LOCAL_DOMAIN_PROVISIONING=true

# Local development only. Forwards resolved storefront requests to a Theme
# Worker already running locally, standing in for the production service
# binding. Start one with:
#   node scripts/theme-artifact-smoke.mjs --artifact <dir> --port 8799
# MORPH_LOCAL_THEME_ORIGIN=http://127.0.0.1:8799

# Required before Live Preview is allowed to execute user-authored JavaScript.
# It must be an isolated origin, different from PUBLIC_URL.
VITE_STOREFRONT_LIVE_PREVIEW_ORIGIN=https://preview.example.net
